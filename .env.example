# JWT — use a long random string (min 32 chars), never commit the real value
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars

# User Service DB
USER_DB_HOST=users-db
USER_DB_PORT=5432
USER_DB_NAME=users_db
USER_DB_USER=vastraco_user
USER_DB_PASSWORD=replace_with_strong_password

# Product Service DB
PRODUCT_DB_HOST=products-db
PRODUCT_DB_PORT=5432
PRODUCT_DB_NAME=products_db
PRODUCT_DB_USER=vastraco_product
PRODUCT_DB_PASSWORD=replace_with_strong_password

# Order Service DB
ORDER_DB_HOST=orders-db
ORDER_DB_PORT=5432
ORDER_DB_NAME=orders_db
ORDER_DB_USER=vastraco_order
ORDER_DB_PASSWORD=replace_with_strong_password

# Inter-service URLs (used inside Docker network)
PRODUCT_SERVICE_URL=http://product-service:3002
USER_SERVICE_URL=http://user-service:3001

# AI Service — AWS Bedrock (IAM user credentials, NOT roles or instance profiles)
# The ai-service uses ONLY these env-var credentials; no default AWS chain is used.
# Steps to activate:
#   1. Create an IAM user with AmazonBedrockFullAccess in your AWS account
#   2. Generate an access key for that user
#   3. In the Bedrock console → Model Access, enable the model in the target region
#   4. Fill in the values below (never commit the real .env file)
AWS_ACCESS_KEY_ID=your_iam_user_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_iam_user_secret_access_key_here
AWS_REGION=us-east-1
# Model options (must have model access enabled in the Bedrock console):
#   amazon.nova-lite-v1:0   — fast, tool use supported (recommended)
#   amazon.nova-pro-v1:0    — highest quality
#   anthropic.claude-3-5-haiku-20241022-v1:0  — fallback if Nova unavailable
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
